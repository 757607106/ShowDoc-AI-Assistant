# ShowDoc API文档爬取系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的API密钥

# 千问大模型API密钥 (必需)
# 验证码识别和 Agent 回退端点复用此账户；也支持已有 DASHSCOPE_API_KEY
# 获取方式: https://dashscope.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key-here

# 千问VL接口地址(OpenAI兼容格式,留空使用代码内默认的专属MaaS端点)
DASHSCOPE_API_URL=https://llm-rtc5v8cnt0umugh9.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# 验证码识别视觉模型(默认qwen3-vl-plus)
QWEN_VL_MODEL=qwen3-vl-plus

# 平台登录签名密钥，必须改为随机值并持久保存
FLASK_SECRET_KEY=your-random-secret-key-here

# 云创业版手机号登录凭证（cyb_rag_md.py 必需）
CYB_PHONE=your-phone-number
CYB_PASSWORD=your-password
# 登录态缓存时长（秒），默认 6 小时；设为 0 表示直到服务重启前持续复用
CYB_TOKEN_TTL=21600

# ContextDB 官方服务；平台状态单独保存至 Docker PostgreSQL
CONTEXTDB_BASE_URL=https://context-database.aliyuncs.com
CONTEXTDB_API_KEY=ctxdb-your-api-key-here
CONTEXTDB_MCP_URL=https://context-database.aliyuncs.com/v1/mcp
CONTEXTDB_KB_ID=             # 可选：已有 Wiki 库 ID；模式必须匹配
CONTEXTDB_GRAPH_KB_ID=       # 可选：已有图谱库 ID；与 Wiki 库独立
CONTEXTDB_GOVERNANCE_KB=_governance  # 仅供旧数据只读迁移，不再写入
CTXDB_AGENT=codex           # 仅开发指导；运行时不调用 CLI

# Docker PostgreSQL 引导管理员；运行应用不可复用该管理员账号
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=55432
# 同一服务，独立数据库和受限账号；URL 中需编码特殊字符
DATABASE_URL=postgresql://showdoc_platform:replace-with-platform-password@127.0.0.1:55432/showdoc_knowledge
AGENT_DATABASE_URL=postgresql://showdoc_agent:replace-with-agent-password@127.0.0.1:55432/showdoc_agent
# OpenSandbox 官方控制服务的原生 PostgreSQL store；不使用平台或 Agent 账号
OPENSANDBOX_STORE_POSTGRESQL_DSN=postgresql://opensandbox_control:replace-with-control-password@host.docker.internal:55432/opensandbox_control
OPEN_SANDBOX_API_KEY=replace-with-a-long-random-api-key
# Fernet.generate_key() 生成；用于服务端成员凭据加密
CREDENTIAL_ENCRYPTION_KEY=
PLATFORM_NAME=企业知识库
# 仅首次引导创建默认管理员；已有账号不会被启动或引导过程重置
PLATFORM_ADMIN_ACCOUNT=admin
PLATFORM_ADMIN_PASSWORD=admin123

# Agent LLM(百炼公开端点 BYOK;未配置时回退上方专属端点的 AGENT_FALLBACK_MODEL)
BAILIAN_API_KEY=
AGENT_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MAIN_MODEL=qwen-max
AGENT_SUB_MODEL=qwen-plus
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_FALLBACK_MODEL=qwen-plus

# 管线产物数据目录
GOVERNANCE_DATA_DIR=downloads
# 单个任务的硬超时（秒）
GOVERNANCE_JOB_TIMEOUT=1800

# 仅原独立爬虫离线导出使用 Docling；平台 Worker 交由 ContextDB 解析与切片
DOCLING_ARTIFACTS_PATH=downloads/_models/docling
RAG_CHUNK_TOKENS=512

# 本地浏览器运行时与缓存目录
PLAYWRIGHT_BROWSERS_PATH=downloads/_models/chromium
CRAWL4_AI_BASE_DIRECTORY=downloads/_cache/browser

# Agent 浏览器：可选的官方 BrowserSkill 0.4.1 原生二进制，默认 downloads/browser-runtime/bsk
# BROWSERSKILL_BINARY=/absolute/path/to/bsk
# 可选：供设置页下载的官方扩展 ZIP；留空仍可从官方 Chrome/Edge 商店安装
# BROWSERSKILL_EXTENSION_PATH=/absolute/path/to/browser-skill-extension.zip
# 配对、ASGI 单 worker 与 SHA256 核验说明：docs/guides/browser-runtime.md

# 通用网页默认拒绝 localhost、内网和保留地址；仅在可信内网部署时按需开启
WEB_CRAWLER_ALLOW_PRIVATE_URLS=false
# 整站批量并发批次大小（默认 10）
WEB_CRAWLER_BATCH_SIZE=10
# 首屏动态接口与异步内容等待时间（秒）
WEB_CRAWLER_DISCOVERY_WAIT=1.2
# 自动点击明确“加载更多”按钮的最大次数
WEB_CRAWLER_LOAD_MORE_CLICKS=6
# 通用接口发现与站点适配器允许遍历的最大分页数
WEB_CRAWLER_MAX_API_PAGES=200
# 已验证站点分页请求间隔（秒）
WEB_CRAWLER_API_DELAY=0.03

# ShowDoc登录凭证 (可选,如需自定义)
SHOWDOC_USERNAME=your-showdoc-username
SHOWDOC_PASSWORD=your-showdoc-password

# 天通资源管理中心站点地址 (可选,默认 http://117.172.29.67:6067)
TIANTONG_BASE_URL=http://117.172.29.67:6067
