# ShowDoc API文档爬取系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的API密钥

# 千问大模型API密钥 (必需)
# 用于验证码识别
# 获取方式: https://dashscope.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key-here

# Flask应用密钥 (可选,用于session加密)
FLASK_SECRET_KEY=your-random-secret-key-here

# 云创业版手机号登录凭证（cyb_rag_md.py 必需）
CYB_PHONE=your-phone-number
CYB_PASSWORD=your-password
# 登录态缓存时长（秒），默认 6 小时；设为 0 表示直到服务重启前持续复用
CYB_TOKEN_TTL=21600

# 内容清洗：crawl4ai / auto / builtin
# 推荐 crawl4ai；auto 在 Crawl4AI 不可用时回退到内置转换器
CYB_CONTENT_PIPELINE=crawl4ai

# 通用网页默认拒绝 localhost、内网和保留地址；仅在可信内网部署时按需开启
WEB_CRAWLER_ALLOW_PRIVATE_URLS=false
# 整站批量并发批次大小（默认 10）
WEB_CRAWLER_BATCH_SIZE=10
# 首屏动态接口与异步内容等待时间（秒）
WEB_CRAWLER_DISCOVERY_WAIT=1.2
# 自动点击明确“加载更多”按钮的最大次数
WEB_CRAWLER_LOAD_MORE_CLICKS=6
# 通用接口发现与站点适配器允许遍历的最大分页数
WEB_CRAWLER_MAX_API_PAGES=200
# 已验证站点分页请求间隔（秒）
WEB_CRAWLER_API_DELAY=0.03

# RAG JSONL 分块参数：先按 Markdown 标题分节，超长章节再按段落切分
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=180

# ShowDoc登录凭证 (可选,如需自定义)
SHOWDOC_USERNAME=your-showdoc-username
SHOWDOC_PASSWORD=your-showdoc-password

# 天通资源管理中心站点地址 (可选,默认 http://117.172.29.67:6067)
TIANTONG_BASE_URL=http://117.172.29.67:6067
