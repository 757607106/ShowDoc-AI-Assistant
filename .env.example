# ShowDoc API文档爬取系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的API密钥

# 千问大模型API密钥 (必需)
# 用于验证码识别
# 获取方式: https://dashscope.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key-here

# Flask应用密钥 (可选,用于session加密)
FLASK_SECRET_KEY=your-random-secret-key-here

# 云创业版手机号登录凭证（cyb_rag_md.py 必需）
CYB_PHONE=your-phone-number
CYB_PASSWORD=your-password

# ShowDoc登录凭证 (可选,如需自定义)
SHOWDOC_USERNAME=your-showdoc-username
SHOWDOC_PASSWORD=your-showdoc-password
